# ---------------------------------------------------------------------------
# SpyGlass (System_Lint)
# ---------------------------------------------------------------------------
# Only the generated session tree is ignored. The authored constraint /
# project files live at the System_Lint root and must stay tracked, which is
# why this is NOT the blanket `System_Lint/` pattern it used to be.
System_Lint/spyglass-1/**
!System_Lint/spyglass-1/**/
!**/spyglass-1_waiver_file.awl
!System_Lint/spyglass-1/consolidated_reports/**

System_Lint/System_Lint/**
!System_Lint/System_Lint/**/
!**/System_Lint_waiver_file.awl
!System_Lint/System_Lint/consolidated_reports/**

# Generated SpyGlass project state (root and nested project dirs).
System_Lint/**/.project_status
System_Lint/**/.project_snapshot
System_Lint/**/.CurrentSessionRunSummaryFiles
System_Lint/**/Run_Summary/
System_Lint/**/html_reports/
System_Lint/**/spyglass_cache/
System_Lint/**/.tmp_*
System_Lint/**/WORK/
System_Lint/*.log
System_Lint/**/.fuse_hidden*

