    <Port>
      <Pref x=194.1350 y=0.0000 side=S width=0.2000 depth=0.7200 />
      <Layer id=2 >
        <Box llx=194.0350 lly=0.0000 urx=194.2350 ury=0.7200 />
      </Layer>
    </Port>
  </Pin>
</IOPins>

