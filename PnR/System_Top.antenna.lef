  END UART_TX_O
  PIN framing_error 
    ANTENNAPARTIALMETALAREA 2.236 LAYER METAL2 ;
    ANTENNAPARTIALMETALSIDEAREA 10.7552 LAYER METAL2 ;
    ANTENNAPARTIALCUTAREA 0.0722 LAYER VIA23 ;
    ANTENNADIFFAREA 1.431 LAYER METAL3 ; 
    ANTENNAPARTIALMETALAREA 4.108 LAYER METAL3 ;
    ANTENNAPARTIALMETALSIDEAREA 19.9519 LAYER METAL3 ;
    ANTENNAMODEL OXIDE1 ;
    ANTENNAGATEAREA 0.1547 LAYER METAL3 ; 
    ANTENNAMAXAREACAR 48.0076 LAYER METAL3 ;
    ANTENNAMAXSIDEAREACAR 230.821 LAYER METAL3 ;
    ANTENNAMAXCUTCAR 1.54274 LAYER VIA34 ;
